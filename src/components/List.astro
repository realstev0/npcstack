---
import Cards from './Cards.astro';
import { active, STAGE_NAMES, ENGINE_NAMES } from '../lib.js';
const { audience } = Astro.props; const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = active.filter(t => t.audience.includes(audience)).sort((a,b)=>a.name.localeCompare(b.name));
const stages = [...new Set(list.flatMap(t=>t.stages))].sort();
const engines = [...new Set(list.flatMap(t=>t.engines))].sort();
---
<p>{list.length} listings. <span class="tag pending">Score: pending tests</span> on every listing. See <a href={b+'/scoring/'}>how scoring works</a>.</p>
<div>
<label>Stage <select id="stage"><option value="">All</option>{stages.map(s=><option value={s}>{STAGE_NAMES[s]||s}</option>)}</select></label>
<label>Engine <select id="engine"><option value="">All</option>{engines.map(e=><option value={e}>{ENGINE_NAMES[e]||e}</option>)}</select></label>
<input id="q" placeholder="Search…" aria-label="Search"/> <span id="count"></span>
</div>
<Cards items={list}/>
<script is:inline>
const f=()=>{const s=stage.value,e=engine.value,q=document.getElementById('q').value.toLowerCase();let n=0;
document.querySelectorAll('#list .card').forEach(c=>{const en=c.dataset.engines.split(' ');const ok=(!s||c.dataset.stages.split(' ').includes(s))&&(!e||en.includes(e)||en.includes('any'))&&(!q||c.dataset.text.includes(q));c.style.display=ok?'':'none';n+=ok});count.textContent=n+' shown'};
['stage','engine','q'].forEach(i=>document.getElementById(i).addEventListener('input',f));f();
</script>
