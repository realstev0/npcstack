---
import { REPO } from '../lib.js';
import Newsletter from '../components/Newsletter.astro';
const { title, description, jsonld = null, ogType = 'website', noindex = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(canonicalPath === '//' ? '/' : canonicalPath, Astro.site).href;
const fullTitle = `${title} | NPCStack`;
const og = new URL(`${b}/og.png`, Astro.site).href;
const ogAlt = 'NPCStack logo: a pixel-art robot NPC with a "!" speech bubble on stacked neon blocks, beside the NPCStack wordmark and the tagline "AI agents & tools for game developers"';
const siteUrl = new URL(`${b}/`, Astro.site).href;
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'NPCStack',
  url: siteUrl,
  logo: { '@type': 'ImageObject', url: new URL(`${b}/icon-512.png`, Astro.site).href, width: 512, height: 512 },
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NPCStack',
  url: siteUrl,
  publisher: { '@id': `${siteUrl}#organization` },
  description: 'Directory of tested AI agents and tools for game developers, filterable by engine and production stage.',
};
const isCurrent = (href) => {
  const h = href.replace(/\/$/, '');
  return path === h || path === `${h}/` || (h === b && (path === b || path === '' || path === `${b}`));
};
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{fullTitle}</title>
<meta name="description" content={description}/>
{noindex ? <meta name="robots" content="noindex"/> : <link rel="canonical" href={canonical}/>}
<meta property="og:type" content={ogType}/><meta property="og:site_name" content="NPCStack"/>
<meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/><meta property="og:image" content={og}/>
<meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content={ogAlt}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={description}/><meta name="twitter:image" content={og}/>
<meta name="twitter:image:alt" content={ogAlt}/>
<link rel="sitemap" href={`${b}/sitemap-index.xml`}/>
<link rel="icon" href={`${b}/favicon.ico`} sizes="48x48"/>
<link rel="icon" type="image/png" sizes="32x32" href={`${b}/favicon-32.png`}/>
<link rel="icon" type="image/png" sizes="512x512" href={`${b}/icon-512.png`}/>
<link rel="apple-touch-icon" sizes="180x180" href={`${b}/apple-touch-icon.png`}/>
<link rel="manifest" href={`${b}/site.webmanifest`}/>
<meta name="theme-color" content="#0f1117"/><meta name="color-scheme" content="dark"/>
<script type="application/ld+json" set:html={JSON.stringify([orgLd, websiteLd])}/>
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>}
<style>
body{font-family:system-ui,sans-serif;margin:0;background:#0f1117;color:#e6e6e6}
a{color:#7cc4ff}header,main,footer{max-width:1000px;margin:auto;padding:1rem}
nav a{display:inline-block;padding:.4rem 0;margin-right:1rem;min-height:24px}.card{border:1px solid #2a2f3a;border-radius:8px;padding:1rem;margin:.6rem 0;background:#161a22}
.tag{display:inline-block;font-size:.75rem;background:#232a36;border-radius:4px;padding:2px 6px;margin:2px}
.pending{background:#4a3b12;color:#ffd77a}
.featured{background:#3a2a5a;color:#e2c8ff;text-decoration:none;border:1px solid #7a5ab8}
.skip{position:absolute;left:-9999px;top:0;background:#7cc4ff;color:#0f1117;padding:.5rem 1rem;z-index:10}.skip:focus{left:1rem}
a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #ffd77a;outline-offset:2px}select,input,button{background:#161a22;color:#eee;border:1px solid #333;padding:.4rem;margin:.2rem}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.brand{display:inline-flex;align-items:center;gap:.5rem;color:#fff;text-decoration:none;vertical-align:middle}.brand img{border-radius:6px}
a[aria-current="page"]{color:#fff;text-decoration:underline;text-underline-offset:3px}
</style>
<script is:inline data-goatcounter="https://npcstack.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head><body>
<a class="skip" href="#main">Skip to content</a>
<header><a class="brand" href={b+'/'}><img src={`${b}/logo-80.png`} width="36" height="36" alt="" decoding="async"/><strong>NPCStack</strong></a>: AI agents for game developers
<nav aria-label="Main">
<a href={b+'/'} aria-current={isCurrent(b+'/') ? 'page' : undefined}>Game dev</a>
<a href={b+'/players/'} aria-current={isCurrent(b+'/players/') ? 'page' : undefined}>Players</a>
<a href={b+'/browse/'} aria-current={isCurrent(b+'/browse/') ? 'page' : undefined}>Engines & stages</a>
<a href={b+'/scoring/'} aria-current={isCurrent(b+'/scoring/') ? 'page' : undefined}>How scoring works</a>
<a href={b+'/sponsored/'} aria-current={isCurrent(b+'/sponsored/') ? 'page' : undefined}>Sponsored disclosure</a>
<a href={b+'/advertise/'} aria-current={isCurrent(b+'/advertise/') ? 'page' : undefined}>Advertise</a>
</nav></header>
<main id="main" tabindex="-1"><slot/></main>
<footer><Newsletter/>
<p><a href={`${REPO}/issues/new/choose`} rel="noopener">Suggest a tool / report a bug</a> (GitHub Issues)</p>
<small>No sponsored or featured listings right now. All scores are pending tests. <a href={b+'/advertise/'}>Get featured</a>.</small>
<p><small>We use <a href="https://www.goatcounter.com/" rel="noopener">GoatCounter</a>, a privacy-friendly analytics tool, to count page views. It sets no cookies and does no personal tracking.</small></p></footer>
</body></html>
