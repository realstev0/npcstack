---
import Base from '../../layouts/Base.astro'; import tools from '../../data/tools.json';
import { STAGE_NAMES, ENGINE_NAMES, slug, REPO } from '../../lib.js';
export function getStaticPaths(){ return tools.map(t=>({params:{id:t.id},props:{t}})); }
const { t } = Astro.props; const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const ifs = Object.entries(t.interfaces).filter(([,v])=>v).map(([k])=>k);
const cat = {'3d-assets':'DesignApplication','2d-art':'DesignApplication',animation:'DesignApplication',audio:'MultimediaApplication',code:'DeveloperApplication',qa:'DeveloperApplication','player-tools':'GameApplication'}[t.stages[0]] || 'DeveloperApplication';
// No ratings or reviews: none have been collected, so we never emit aggregateRating.
const jsonld = { '@context':'https://schema.org', '@type':'SoftwareApplication', name:t.name, url:t.url, description:t.tagline, applicationCategory:cat,
  operatingSystem: t.interfaces.web ? 'Web' : undefined,
  ...(t.pricing.model==='free' ? { offers:{ '@type':'Offer', price:'0', priceCurrency:'USD' } } : {}) };
const desc = `${t.name}: ${t.tagline} Engines: ${t.engines.map(e=>ENGINE_NAMES[e]||e).join(', ')}. Score pending tests.`.slice(0,300);
---
<Base title={`${t.name}: AI tool for game developers`} description={desc} jsonld={jsonld}>
<p><a href={b+'/'}>Directory</a> › {t.name}</p>
<h1>{t.name}</h1>{t.sponsored && <p class="tag">Sponsored. See <a href={b+'/sponsored/'}>disclosure</a></p>}
<p>{t.tagline}</p>
<p><a href={t.affiliate_url || t.url} rel={t.affiliate_url ? 'sponsored noopener' : 'noopener'} target="_blank">Visit {t.url}</a></p>
<div class="card"><strong>Score:</strong> <span class="tag pending">pending tests</span>. No hands-on test has been run yet. <a href={b+'/scoring/'}>Methodology</a></div>
<ul>
<li>Audience: {t.audience.join(', ')}</li>
<li>Stages: {t.stages.map(s=><a class="tag" href={`${b}/stage/${slug(s)}/`}>{STAGE_NAMES[s]||s}</a>)}</li>
<li>Engines: {t.engines.map(e=><a class="tag" href={`${b}/engine/${slug(e)}/`}>{ENGINE_NAMES[e]||e}</a>)}</li>
<li>Pricing model: {t.pricing.model}; free tier: {t.pricing.free_tier===null?'not confirmed':t.pricing.free_tier?'yes (per vendor site)':'no'}{t.pricing.notes && ` (${t.pricing.notes})`}</li>
<li>Interfaces (per vendor site): {ifs.length?ifs.join(', '):'not confirmed'}</li>
<li>Open source: {t.open_source?'yes':'no / unknown'}{t.github && <> (<a href={`https://github.com/${t.github}`}>{t.github}</a>)</>}</li>
<li>URL verified reachable: {t.url_verified} · Listed: {t.first_seen}</li></ul>
<p><small>Descriptions summarize the vendor's own website. They are not independent test results. Something wrong? <a href={`${REPO}/issues/new?template=bug_report.yml&title=${encodeURIComponent('Listing: '+t.name)}`}>Report it</a>.</small></p></Base>
